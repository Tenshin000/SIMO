<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Escludi esplicitamente le preferenze contenenti dati sensibili e API Key -->
        <exclude domain="sharedpref" path="simo_prefs.xml"/>
    </cloud-backup>
    <device-transfer>
        <!-- La chiave crittografica hardware TEE non è trasferibile su un nuovo telefono.
             L'utente dovrà reinserire la propria API key sul nuovo dispositivo. -->
        <exclude domain="sharedpref" path="simo_prefs.xml"/>
    </device-transfer>
</data-extraction-rules>